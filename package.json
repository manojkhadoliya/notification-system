{
  "name": "notification-system",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant, multi-channel notification delivery system — pnpm workspace root. See docs/ for architecture and ADRs.",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -b --force",
    "test": "pnpm -r --if-present run test",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages services",
    "compose:up": "docker compose -f infra/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/docker-compose.yml down",
    "compose:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "kafka:topics": "bash infra/kafka/create-topics.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.14.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
