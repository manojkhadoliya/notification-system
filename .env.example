# Local dev defaults matching infra/docker-compose.yml. Copy to `.env`
# (git-ignored) and override as needed. Full var list grows in Phase 1 as
# each services/* composition root is wired — this covers only what the
# Phase 0 infra containers themselves expose.

DATABASE_URL=postgresql://notification:notification@localhost:5432/notification
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# Consumed by packages/observability's startTracing() — see its README.
# Points at the jaeger container's OTLP/HTTP receiver.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# services/api — see its README. PORT/HOST are optional (default 3000 /
# 0.0.0.0); KAFKA_CLIENT_ID is optional (defaults to "services-api").
PORT=3000
HOST=0.0.0.0

# services/inapp-gateway — see its README. Also reads PORT/HOST above, but
# defaults to 3001/0.0.0.0 if unset, so running it alongside services/api
# locally needs only one of the two processes to get an explicit PORT
# (each runs in its own env in any real deployment, same as services/api).
# REDIS_URL (above) is its only other required var — no DATABASE_URL/
# KAFKA_BROKERS: this service has no Kafka membership and no domain
# repository ports (see ADR 0012).
