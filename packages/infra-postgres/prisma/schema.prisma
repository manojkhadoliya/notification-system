// Prisma schema for the one shared Postgres database every context but
// Notification Delivery's write side (Kafka) lives in — see
// docs/architecture/data-model.md (the source of truth for every field
// below) and ADR 0003 (revised: Postgres carries Notification Delivery's
// read model too, for Phase 1). Model grouping mirrors data-model.md's
// section order, one bounded context at a time — not because Prisma
// requires it, but because a reader comparing this file to that doc
// should be able to go section by section.
//
// snake_case column/table names (`@map`/`@@map`) match data-model.md
// exactly; camelCase field names are idiomatic Prisma/TypeScript. No
// cross-context relations (`@relation`) are declared between models that
// belong to different bounded contexts, even where an id-reference exists
// (e.g. Preference.recipientId -> Recipient is same-context and *is* a
// Prisma relation; NotificationRequest.recipientId -> Recipient is
// cross-context and is deliberately just a plain column) — see
// domain-model.md#context-map: "Contexts reference each other by id
// only — never by foreign-key join."

generator client {
  provider = "prisma-client-js"
  // A custom output path, imported directly (see src/prisma-client.ts),
  // sidesteps a real Prisma 5.x gotcha in a pnpm workspace: the bare
  // `@prisma/client` package specifier's "node" export condition resolves
  // to `default.d.ts` — an untyped stub (`PrismaClient: any`, no model
  // types) meant for edge/worker runtimes — rather than the fully
  // generated client, unless a custom output makes the import path
  // unambiguous. Regenerated by `prisma generate` (also runs
  // automatically on `pnpm install` — see this package's `postinstall`
  // script); not checked into git.
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shared across contexts — see shared-kernel's Channel/Priority/DeliveryStatus.
enum Channel {
  sms
  push
  email
  in_app
}

enum Priority {
  critical
  standard
  bulk
}

enum DeliveryStatus {
  accepted
  sent
  delivered
  failed
}

// ---------------------------------------------------------------------
// Identity & Tenancy
// ---------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  apiKeys ApiKey[]

  @@map("tenants")
}

model ApiKey {
  id     String @id @default(uuid()) @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])

  tenantId  String    @map("tenant_id") @db.Uuid
  // Never the raw key — see multi-tenancy.md#auth. Unique because
  // findByHashedKey (ApiKeyRepository) must resolve to at most one key.
  hashedKey String    @unique @map("hashed_key")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@map("api_keys")
}

// ---------------------------------------------------------------------
// Recipient Preferences
// ---------------------------------------------------------------------
// RecipientKey (crypto-shredding) is deliberately absent — data-model.md
// marks it "designed now, build deferred... not part of the Phase 1
// schema." See ADR 0013.

model Recipient {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  phone     String?
  pushToken String?  @map("push_token")
  email     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  preferences Preference[]

  @@map("recipients")
}

model Preference {
  id        String    @id @default(uuid()) @db.Uuid
  recipient Recipient @relation(fields: [recipientId], references: [id])

  recipientId      String    @map("recipient_id") @db.Uuid
  channel          Channel
  notificationType String    @map("notification_type")
  optedIn          Boolean   @map("opted_in")
  // SQL `time`, not a full timestamp — a recurring daily window, not an
  // instant. See domain-preferences' quiet-hours.ts for how the domain
  // layer represents the same thing as minutes-since-midnight; converting
  // between the two is this adapter's job.
  quietHoursStart  DateTime? @map("quiet_hours_start") @db.Time(0)
  quietHoursEnd    DateTime? @map("quiet_hours_end") @db.Time(0)
  // Deferred — reserved column, not read by the router yet. Prisma has no
  // nullable-list distinct from empty-list, so the adapter treats `[]` as
  // "unset" (see domain-model.md#recipient-preferences).
  fallbackOrder    Channel[] @map("fallback_order")

  @@unique([recipientId, channel, notificationType])
  @@map("preferences")
}

// ---------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------

model Template {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  channel   Channel
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  versions TemplateVersion[]

  @@unique([tenantId, name])
  @@map("templates")
}

model TemplateVersion {
  id       String   @id @default(uuid()) @db.Uuid
  template Template @relation(fields: [templateId], references: [id])

  templateId String   @map("template_id") @db.Uuid
  locale     String
  version    Int
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([templateId, locale, version])
  @@map("template_versions")
}

// ---------------------------------------------------------------------
// Notification Delivery (core domain) — read-model projection only.
// Kafka is the write side and log of record (ADR 0008); nothing on the
// delivery path reads through NotificationRepository (ADR 0009). Postgres
// for Phase 1, behind the same ports a future infra-cassandra adapter
// would implement — see ADR 0003 (revised) and
// scaling-strategy.md#storage-phasing.
// ---------------------------------------------------------------------

model NotificationRequest {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  recipientId      String         @map("recipient_id") @db.Uuid
  notificationType String         @map("notification_type")
  // Ingest-time dedup happens earlier, via IdempotencyStore (Redis) — see
  // data-model.md. Not unique here for that reason.
  idempotencyKey   String         @map("idempotency_key")
  channel          Channel
  broadcastId      String?        @map("broadcast_id") @db.Uuid
  payload          Json
  // Written only by services/projection-notification, in strict order —
  // see ADR 0010#single-writer-status. This column has no CHECK constraint
  // enforcing the state machine; that invariant lives in
  // NotificationRequest.advanceStatus (domain-notification), not SQL.
  status           DeliveryStatus
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  attempts DeliveryAttempt[]

  @@map("notification_requests")
}

model DeliveryAttempt {
  request NotificationRequest @relation(fields: [notificationRequestId], references: [id])

  notificationRequestId String         @map("notification_request_id") @db.Uuid
  attemptNumber         Int            @map("attempt_number")
  // domain-notification's AttemptStatus (sent|failed|delivered) is a
  // strict subset of DeliveryStatus (no "accepted" — an attempt doesn't
  // exist until it's been made), so it reuses the same Postgres enum
  // rather than declaring a second, near-identical one.
  status                DeliveryStatus
  providerResponse      String?        @map("provider_response")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([notificationRequestId, attemptNumber])
  @@map("delivery_attempts")
}

model DedupeClaim {
  // Composite PK *is* the unique constraint the conditional-write claim
  // relies on — see ADR 0010 and dedupe-claim.ts's doc comment. No
  // separate `id` column; the natural key is the whole point.
  tenantId              String   @map("tenant_id") @db.Uuid
  notificationRequestId String   @map("notification_request_id") @db.Uuid
  recipientId           String   @map("recipient_id") @db.Uuid
  channel               Channel
  claimedAt             DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)

  @@id([tenantId, notificationRequestId, recipientId, channel])
  @@map("dedupe_claims")
}

enum ScheduledNotificationStatus {
  pending
  claimed
  emitted
}

model ScheduledNotification {
  id                String                      @id @default(uuid()) @db.Uuid
  tenantId          String                      @map("tenant_id") @db.Uuid
  recipientId       String                      @map("recipient_id") @db.Uuid
  notificationType  String                      @map("notification_type")
  channel           Channel?
  templateVersionId String?                     @map("template_version_id") @db.Uuid
  payload           Json
  priority          Priority
  dueAt             DateTime                    @map("due_at") @db.Timestamptz(6)
  // Derived from dueAt at write time — see ADR 0011#poller-sharding. Not
  // recomputed by Postgres (no generated column): the domain layer derives
  // it once, in ScheduledNotification.schedule, and this column just
  // stores that value so the poller's shard query can index on it.
  dueMinute         Int                         @map("due_minute")
  status            ScheduledNotificationStatus
  claimedAt         DateTime?                   @map("claimed_at") @db.Timestamptz(6)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  // The poller's claim query: "pending rows due by now, in my shard."
  @@index([status, dueMinute])
  @@map("scheduled_notifications")
}

// `in_app`-only feed projection — see data-model.md#notificationfeeditem
// and messaging.md#in-app-is-structurally-different. Added alongside
// services/worker-inapp, which is the only writer.
model NotificationFeedItem {
  id                    String    @id @default(uuid()) @db.Uuid
  recipientId           String    @map("recipient_id") @db.Uuid
  // Unique, not just indexed — services/worker-inapp upserts on this key
  // so a redelivered command.in_app message (a retry, or Kafka's
  // at-least-once redelivery) writes the same logical feed item again,
  // never a duplicate row. See NotificationFeedRepository.save's doc
  // comment.
  notificationRequestId String    @unique @map("notification_request_id") @db.Uuid
  summary               String
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt                DateTime? @map("read_at") @db.Timestamptz(6)

  // "The feed" query: this recipient's items, most recent first.
  // data-model.md calls out a *partial* index on (recipient_id, read_at)
  // (i.e. WHERE read_at IS NULL, for the unread-only case) as the real
  // target — Prisma's schema DSL doesn't express a partial index, so this
  // is the plain composite version; add the partial one by hand in a
  // migration if/when unread-feed reads are actually measured as hot.
  @@index([recipientId, createdAt])
  @@map("notification_feed_items")
}
